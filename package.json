{
  "name": "pumpfun-bot",
  "version": "0.1.0",
  "description": "Paper-first pump.fun momentum trading bot (PumpPortal feed, simulated or live execution)",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/index.js",
